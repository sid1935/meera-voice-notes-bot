# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional but recommended: a random string used to verify that incoming
# webhook requests really come from Telegram. Generate one with, e.g.,
# `openssl rand -hex 24`, put it here, and register the SAME value with
# Telegram via `npm run set-webhook`.
TELEGRAM_WEBHOOK_SECRET=

# Supabase project URL, from Project Settings -> API
SUPABASE_URL=

# Supabase SERVICE ROLE key (not the anon key) — this runs server-side only
# and needs full read/write access. Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
