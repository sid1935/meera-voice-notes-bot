# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended: a random string used to verify that incoming
# webhook requests really come from Telegram. Generate one with, e.g.,
# `openssl rand -hex 24`, put it here, and register the SAME value with
# Telegram via `npm run set-webhook`.
TELEGRAM_WEBHOOK_SECRET=
